{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proscenium-services-local-only",
  "main": "test/rehearsal-entry.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "vars": {
    "UPDATES_ENABLED": "true", "DOWNLOADS_ENABLED": "true",
    "RELEASED_VERSIONS_JSON": "[\"0.0.0\",\"0.1.0\"]"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "proscenium-services-local", "database_id": "00000000-0000-0000-0000-000000000007", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "TRACKS", "bucket_name": "proscenium-updates-local" }],
  "ratelimits": [
    { "name": "UPDATE_LIMIT", "namespace_id": "7001", "simple": { "limit": 60, "period": 60 } },
    { "name": "DOWNLOAD_LIMIT", "namespace_id": "7002", "simple": { "limit": 12, "period": 60 } }
  ]
}
