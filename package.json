{
  "name": "proscenium",
  "version": "1.0.0",
  "description": "A local-first, cross-platform playwriting app.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:full": "node scripts/test-full.mjs",
    "check:layout": "bash scripts/check-layout-constants.sh",
    "dict:sync": "node scripts/sync-dictionary.mjs",
    "tauri": "tauri",
    "icon": "bun scripts/make-icon.ts",
    "app:install": "bun run icon && node scripts/build-app.mjs --local && node scripts/install-app.mjs",
    "check:design": "bash scripts/check-design-tokens.sh",
    "smoke": "bun run build && node scripts/smoke.mjs",
    "check:spdx": "bash scripts/check-spdx.sh",
    "check:network": "node scripts/check-network.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check:webkit-network": "bun scripts/check-webkit-network.ts",
    "check:webkit-floor": "vite build --logLevel warn && bun scripts/check-webkit-floor.ts",
    "check:version": "node scripts/version.mjs --check",
    "version": "node scripts/version.mjs",
    "build:universal": "bun run icon && node scripts/build-app.mjs --universal --dmg",
    "build:selftest": "bun run icon && node scripts/build-app.mjs --universal --selftest",
    "check:docs": "bun test ./scripts/check-docs.test.ts && bun scripts/check-docs.ts",
    "gates": "node scripts/gates.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "fountain-js": "^1.1.2",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "prosemirror-model": "1.25.11",
    "prosemirror-view": "1.42.3"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "^8.1.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "axe-core": "4",
    "css-tree": "^3.2.1",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "3.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
